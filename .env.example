# Runtime listener (use HOST=127.0.0.1 behind Apache mod_proxy on a WordPress/Apache VPS)
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Optional subpath if mounted alongside WordPress (e.g. BASE_PATH=/georoute)
BASE_PATH=

# Reverse proxy hops (set 1 for Apache -> Node, or 2 for Cloudflare -> Apache -> Node)
TRUST_PROXY=1

# SQLite storage path
DATABASE_PATH=./data/georoute.db

# Generate strong 64-char hex secrets with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Label shown in Diagnostics location warning
DIAGNOSTICS_LOCATION=Apache-Linux-Server

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
