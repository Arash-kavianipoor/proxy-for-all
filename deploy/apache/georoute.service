[Unit]
Description=GeoRoute Manager Control Plane (Apache Upstream on 127.0.0.1:3000)
After=network.target apache2.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/georoute-manager
EnvironmentFile=/opt/georoute-manager/.env
ExecStart=/usr/bin/node /opt/georoute-manager/dist-server/server.mjs
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
